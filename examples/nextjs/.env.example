# PAYMENT_MODE: mock (no keys needed) | sandbox | live
PAYMENT_MODE=mock

# bKash Tokenized Checkout — get from https://developer.bkash.com
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad — get from https://developer.nagad.com.bd
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mfs.sandbox.nagad.com.bd

# SSLCommerz — get from https://sslcommerz.com merchant panel
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

NEXT_PUBLIC_APP_URL=http://localhost:3000
